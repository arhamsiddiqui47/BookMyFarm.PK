PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookmyfarm
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@bookmyfarm.pk
ADMIN_PASSWORD=admin123
# Optional. Paste the "API environment variable" from your Cloudinary dashboard.
# Leave empty to save photos in server/uploads (fine on your laptop, not on Render).
CLOUDINARY_URL=
# Public address of this API, used to build photo links when saving locally.
PUBLIC_API_URL=http://localhost:5000
